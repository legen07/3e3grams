{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["**/*.ts"]
}
